# Shared project path on this worker machine.
AGENT_RELAY_ROOT=/absolute/path/to/agent-relay
AGENT_RELAY_LOG_DIR=/absolute/path/to/agent-relay/data/logs

# Private URL for the relay server.
AGENT_RELAY_URL=https://relay.example.ts.net
AGENT_RELAY_TOKEN=replace-with-the-server-token

# Stable identity for this worker.
AGENT_ID=probe@macbook
HOST_ID=macbook
AGENT_KIND=probe
AGENT_CAPABILITIES=network.probe
