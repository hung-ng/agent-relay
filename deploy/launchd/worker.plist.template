<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-relay.worker.@@AGENT_ID@@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@NODE_BIN@@</string>
    <string>@@AGENT_RELAY_ROOT@@/src/cli.js</string>
    <string>worker</string>
    <string>--server</string>
    <string>@@AGENT_RELAY_URL@@</string>
    <string>--agent</string>
    <string>@@AGENT_ID@@</string>
    <string>--host</string>
    <string>@@HOST_ID@@</string>
    <string>--kind</string>
    <string>@@AGENT_KIND@@</string>
    <string>--capabilities</string>
    <string>@@AGENT_CAPABILITIES@@</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@@AGENT_RELAY_ROOT@@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@@AGENT_RELAY_PATH@@</string>
    <key>AGENT_RELAY_TOKEN</key>
    <string>@@AGENT_RELAY_TOKEN@@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>@@AGENT_RELAY_LOG_DIR@@/@@AGENT_ID@@.log</string>
  <key>StandardErrorPath</key>
  <string>@@AGENT_RELAY_LOG_DIR@@/@@AGENT_ID@@.error.log</string>
</dict>
</plist>
