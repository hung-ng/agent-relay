# Absolute paths on the server machine.
AGENT_RELAY_ROOT=/absolute/path/to/agent-relay
AGENT_RELAY_DATA=/absolute/path/to/agent-relay/data
AGENT_RELAY_LOG_DIR=/absolute/path/to/agent-relay/data/logs

# Bind only to a private interface or localhost behind a private proxy.
AGENT_RELAY_HOST=127.0.0.1
AGENT_RELAY_PORT=8787

# Set this before rendering the plist. Keep the rendered plist private.
AGENT_RELAY_TOKEN=replace-with-a-long-random-token
